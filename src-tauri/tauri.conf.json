{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "vocal-teleprompter",
    "version": "1.1.1",
    "identifier": "com.angel.vocal-teleprompter",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "vocal-teleprompter",
                "width": 1200,
                "height": 600,
                "transparent": true,
                "decorations": false,
                "skipTaskbar": true,
                "alwaysOnTop": true,
                "contentProtected": true,
                "shadow": false
            }
        ],

        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjk3MUFDMEQ0Q0NBMTkKUldRWnlrd05ySEZwWGNNYytTdi9icW1nRytpWGxFeU5Wak9wOFpYNldKeFBWTzdNSUJ5VUY0cmwK",
            "endpoints": [
                "https://github.com/FaureGalliard/vocal-teleprompter/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
